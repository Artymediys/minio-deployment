# Remote volumes to be used for MinIO Server
MINIO_VOLUMES="http://{{ minio_servername_prefix }}{1...{{ groups['minio_servers'] | length }}}.{{ minio_servername_dns_zone }}:9000{{ minio_data_dir }}{1...{{ minio_mounts | length }}}/"

# Remote volumes to be used for MinIO Server
{% set volumes = [] %}
{% for server in groups['minio_servers'] %}
  {% set server_name = hostvars[server]['inventory_hostname'] %}
  {% for disk in range(1, minio_mounts | length + 1) %}
    {% set volume = "http://" + server_name + ":9000" + minio_data_dir + disk | string %}
    {% set _ = volumes.append(volume) %}
  {% endfor %}
{% endfor %}

MINIO_VOLUMES="{{ volumes | join(' ') }}"

# TODO: add a toggle for options above 

# Set all MinIO server options
MINIO_OPTS="{{ minio_opts }}"

# Set the root username
MINIO_ROOT_USER="{{ minio_root_user }}"

# Set the root password
MINIO_ROOT_PASSWORD="{{ minio_root_password }}"

# Set to the URL of the load balancer for the MinIO deployment
# MINIO_SERVER_URL="https://minio.rshb.ru:9000"

# Standard storage class
MINIO_STORAGE_CLASS_STANDARD="EC:{{ minio_standard_ec_parity_drives }}"

# Reduced redundancy storage class
MINIO_STORAGE_CLASS_RRS="EC:{{ minio_rrs_ec_parity_drives }}"